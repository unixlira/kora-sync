<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:imaging="clr-namespace:System.Windows.Media.Imaging;assembly=PresentationCore">

    <!--
        Chaves idênticas em DarkTheme.xaml e LightTheme.xaml de propósito —
        App.xaml.cs troca qual dos dois está mesclado, e todo o resto do app
        referencia só os nomes abaixo (WindowBackgroundBrush etc.), nunca um
        hex direto.
    -->

    <Color x:Key="WindowBackgroundColor">#0D0D0D</Color>
    <Color x:Key="CardBackgroundColor">#1A1A2E</Color>
    <Color x:Key="BorderColor">#2A2A3E</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#6B6B7B</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- Versão do logo com cores que ficam legíveis sobre fundo escuro. -->
    <imaging:BitmapImage x:Key="LogoImageSource" UriSource="/Assets/logo_dark.png" />

</ResourceDictionary>
