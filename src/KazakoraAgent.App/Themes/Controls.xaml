<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cantos arredondados e padding generoso, com sombra suave (opacidade/profundidade
         variam por tema — ver CardShadowOpacity/CardShadowDepth em Dark/LightTheme.xaml). -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                   Opacity="{DynamicResource CardShadowOpacity}"
                                   ShadowDepth="{DynamicResource CardShadowDepth}"
                                   Direction="270" BlurRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card clicável (canal de venda) — realça borda e sombra ao passar o mouse,
         reforçando visualmente que é interativo. -->
    <Style x:Key="InteractiveCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card de status da fila (Na fila/Imprimindo/Concluídas/Falharam) — igual
         ao CardStyle, mas sem Background/BorderBrush fixos: cada instância
         define a própria cor (tingida no status) via binding direto no
         elemento. Só a sombra "levanta" um pouco ao passar o mouse. -->
    <Style x:Key="StatusCardStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                   Opacity="{DynamicResource CardShadowOpacity}"
                                   ShadowDepth="{DynamicResource CardShadowDepth}"
                                   Direction="270" BlurRadius="16" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="{DynamicResource ShadowColor}"
                                           Opacity="{DynamicResource CardShadowOpacity}"
                                           ShadowDepth="6" BlurRadius="22" Direction="270" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Bolinha de status (verde/amarelo/vermelho) com anel na cor do fundo do
         card por trás — separa visualmente a bolinha do conteúdo ao redor. -->
    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="11" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Stroke" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
    </Style>

    <!-- Barrinha colorida vertical usada antes de títulos de seção (ex: "Canais de venda"). -->
    <Style x:Key="SectionAccentBarStyle" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- Link clicável estilo "Desenvolvido com ❤ por Lira" no rodapé. -->
    <Style x:Key="FooterLinkStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- Estilo implícito (sem x:Key — vale pra TODO Button do app) que
         substitui o ControlTemplate padrão do WPF. Achado real (2026-08-04):
         sem um template próprio, o botão desabilitado (ex: "Imprimir
         etiqueta" já impresso) ignora o Background definido na instância e
         renderiza com o cinza/branco padrão do Windows — no tema escuro isso
         aparece como uma mancha branca no card. Agora o estado desabilitado
         só reduz a opacidade, mantendo a cor real do botão nos dois temas. -->
    <Style TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <!-- A troca real: opacidade em vez de cor de sistema. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
