<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Cores da marca e de status — iguais nos dois temas (dark/light),
        por isso ficam num dicionário separado, sempre mesclado, nunca
        trocado pela troca de tema.
    -->

    <!-- Verde correto da marca/logo, pedido explícito 2026-08-04 (o
         #00E676 anterior não batia com o logo real). StatusSuccessColor
         é mantido sincronizado de propósito — ver mesmo valor replicado
         em Theming/ChannelBrandColors.cs (Store) e
         Theming/QueueStatusColors.cs (Success), documentado lá como
         "mesmos valores de Themes/BrandColors.xaml". BrandHoverColor é um
         escurecimento proporcional (~15%) do novo primário, já que não
         foi especificado um tom de hover próprio. -->
    <Color x:Key="BrandPrimaryColor">#04D7B6</Color>
    <Color x:Key="BrandHoverColor">#03B79B</Color>
    <Color x:Key="SuccessBackgroundColor">#1B3A2B</Color>

    <Color x:Key="StatusSuccessColor">#04D7B6</Color>
    <Color x:Key="StatusWarningColor">#FFB74D</Color>
    <Color x:Key="StatusErrorColor">#FF5252</Color>
    <Color x:Key="StatusProcessingColor">#40C4FF</Color>

    <!-- Preto puro pra sombra de card — a opacidade é ajustada por tema
         (mais forte no claro, mais sutil no escuro) nos Setters do Effect. -->
    <Color x:Key="ShadowColor">#000000</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackgroundColor}" />

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusProcessingBrush" Color="{StaticResource StatusProcessingColor}" />

    <!--
        Variantes com alfa (fundo bem sutil ~14%, borda um pouco mais forte
        ~40%) dos cards de status da fila — mesmo padrão visual dos cards
        de "Impressões" do painel Casa Cora (bg-X-50/border-X-200 do
        Tailwind). Funcionam iguais nos dois temas porque o alfa se mistura
        com o fundo por trás (escuro vira tom escurecido, claro vira
        pastel), sem precisar de valor separado por tema.
    -->
    <Color x:Key="StatusWarningSoftColor">#26FFB74D</Color>
    <Color x:Key="StatusWarningSoftBorderColor">#66FFB74D</Color>
    <Color x:Key="StatusProcessingSoftColor">#2640C4FF</Color>
    <Color x:Key="StatusProcessingSoftBorderColor">#6640C4FF</Color>
    <Color x:Key="StatusSuccessSoftColor">#2604D7B6</Color>
    <Color x:Key="StatusSuccessSoftBorderColor">#6604D7B6</Color>
    <Color x:Key="StatusErrorSoftColor">#26FF5252</Color>
    <Color x:Key="StatusErrorSoftBorderColor">#66FF5252</Color>

    <SolidColorBrush x:Key="StatusWarningSoftBrush" Color="{StaticResource StatusWarningSoftColor}" />
    <SolidColorBrush x:Key="StatusWarningSoftBorderBrush" Color="{StaticResource StatusWarningSoftBorderColor}" />
    <SolidColorBrush x:Key="StatusProcessingSoftBrush" Color="{StaticResource StatusProcessingSoftColor}" />
    <SolidColorBrush x:Key="StatusProcessingSoftBorderBrush" Color="{StaticResource StatusProcessingSoftBorderColor}" />
    <SolidColorBrush x:Key="StatusSuccessSoftBrush" Color="{StaticResource StatusSuccessSoftColor}" />
    <SolidColorBrush x:Key="StatusSuccessSoftBorderBrush" Color="{StaticResource StatusSuccessSoftBorderColor}" />
    <SolidColorBrush x:Key="StatusErrorSoftBrush" Color="{StaticResource StatusErrorSoftColor}" />
    <SolidColorBrush x:Key="StatusErrorSoftBorderBrush" Color="{StaticResource StatusErrorSoftBorderColor}" />

</ResourceDictionary>
