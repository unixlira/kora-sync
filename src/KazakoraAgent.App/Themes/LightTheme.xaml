<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:imaging="clr-namespace:System.Windows.Media.Imaging;assembly=PresentationCore">

    <Color x:Key="WindowBackgroundColor">#F5F5F7</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#E0E0E8</Color>
    <Color x:Key="TextPrimaryColor">#0D0D0D</Color>
    <Color x:Key="TextSecondaryColor">#6B6B7B</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <!-- Versão do logo com cores que ficam legíveis sobre fundo claro. -->
    <imaging:BitmapImage x:Key="LogoImageSource" UriSource="/Assets/logo_light.png" />

</ResourceDictionary>
