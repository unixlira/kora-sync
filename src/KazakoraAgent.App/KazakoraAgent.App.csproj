<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Só pra NotifyIcon (ícone da bandeja) — WPF não tem equivalente
         próprio, esse é o jeito padrão/consagrado de fazer isso. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Permite restaurar/compilar (não rodar) fora do Windows — usado só
         pra checar erro de sintaxe aqui no ambiente de dev Linux; o build
         "de verdade" continua sendo feito no Windows. -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Publicado como .exe único auto-contido — ver README pro comando exato. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KazakoraAgent.Core\KazakoraAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo_dark.png" />
    <Resource Include="Assets\logo_light.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
