<Window x:Class="KazakoraAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KazakoraAgent.App.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="KoraSync" Height="820" Width="1360"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Card de métrica (topo): ícone numa bolha colorida + rótulo (com
             período real vindo do servidor) + número grande + variação
             percentual colorida (verde alta, vermelha queda), quando houver
             base de comparação. Sem x:Key de propósito — é resolvido
             implicitamente pelo DataType (mesmo padrão já usado pros cards
             de canal/fila), pra poder conviver com ChannelOrdersCardTemplate
             na mesma UniformGrid (ver TopCards no MainViewModel). Sem
             largura/margem fixa: a UniformGrid do container é quem garante
             que todo card do topo tenha exatamente o mesmo tamanho,
             adaptável a qualquer largura de janela/monitor. -->
        <DataTemplate DataType="{x:Type vm:MetricCardViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="8" Padding="22">
                <!-- Grid, não StackPanel horizontal — mesma correção do
                     ChannelOrdersCardTemplate (ver comentário lá): StackPanel
                     horizontal dá largura infinita pro filho, o que quebra
                     TextWrapping/TextTrimming (o texto nunca sabe onde
                     cortar/quebrar de verdade). Coluna "*" constrange o
                     espaço disponível de verdade. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse Fill="{Binding AccentBrush}" Opacity="0.16" />
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Width="28" Height="28"
                                                     Foreground="{Binding AccentBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding PeriodLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Value}" Style="{StaticResource MetricValueTextStyle}"
                                   FontSize="30" Foreground="{Binding NumberBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding VariationText}" Foreground="{Binding VariationBrush}"
                                   Visibility="{Binding VariationVisibility}" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 5º card do topo — "Pedidos por canal, mês/hoje". Mesmo visual
             dos outros 4 (ícone em bolha + rótulo), mas o "valor" é uma
             lista de chips "Nome: mês/hoje" (ex: "MeLi: 4/0"), sempre as 4
             integrações externas, mesmo zeradas (0/0) — ver
             ChannelOrdersCardViewModel. -->
        <DataTemplate DataType="{x:Type vm:ChannelOrdersCardViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="8" Padding="22">
                <!-- Grid, não StackPanel horizontal: um StackPanel horizontal
                     dá largura INFINITA pro filho, então o WrapPanel das
                     badges nunca detectava que precisava quebrar (só
                     descobria o limite real, tarde demais, na hora de
                     desenhar — daí o corte). A coluna "*" aqui constrange de
                     verdade o espaço disponível, então o WrapPanel quebra
                     pra segunda linha de verdade quando não couber mais. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource BrandPrimaryBrush}" Opacity="0.16" />
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Width="28" Height="28"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <!-- Badges pequenas de propósito (pedido explícito
                             2026-08-04) — as 5 integrações precisam caber
                             sem fazer esse card (e por tabela os outros 4 da
                             mesma UniformGrid, que têm altura sincronizada)
                             crescerem de tamanho. -->
                        <ItemsControl ItemsSource="{Binding Entries}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding AccentBrush}" Opacity="0.85" CornerRadius="7" Padding="6,2" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Card de pedido em destaque (os 2 "quadrados" da esquerda,
             pedido explícito 2026-08-06, foto adicionada 2026-08-15) —
             foto à esquerda + número/QTD, produtos e nome do cliente à
             direita dela, canal/id externo pequenos embaixo. Estado vazio
             (menos de 2 pedidos hoje) mostra um placeholder em vez de um
             card em branco.

             REDESENHADO 2026-08-15 (pedido explícito, depois de reportar
             que a versão anterior — 3 cards + Viewbox encolhendo até
             ilegível — tinha ficado pior): produto/cliente NÃO usam mais
             Viewbox com StretchDirection="DownOnly" (fonte ia encolhendo
             sem piso, virava ilegível num pedido com muitos produtos).
             Fonte fixa e legível agora; se o conteúdo passar do espaço
             normal (~3 linhas), rola dentro de um ScrollViewer em vez de
             encolher — texto NUNCA fica pequeno demais pra ler, só rola. -->
        <DataTemplate x:Key="OrderQueueBigCardTemplate" DataType="{x:Type vm:OrderQueueCardViewModel}">
            <Grid>
                <StackPanel Visibility="{Binding EmptyStateVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="TrayFull" Width="36" Height="36" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum pedido" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Coluna da foto (esquerda) + coluna do conteúdo
                     (direita) — pedido explícito 2026-08-15. Largura fixa
                     84 pra foto: precisa ser real (não "*"/Auto) pra Image
                     ter uma caixa concreta pra encaixar contra. Margem
                     vertical de 25px em cima/embaixo (pedido explícito) —
                     a foto fica "inset", não colada nas bordas do card. -->
                <Grid Visibility="{Binding HasOrderVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Foto do produto — mesma imagem publicada nos
                         marketplaces (ver OrderImageArchiveService no
                         Laravel). Stretch="Uniform" (nunca "UniformToFill"
                         — corta a imagem, já tentado e revertido) mostra a
                         imagem INTEIRA sempre, encolhida pra caber. Sem
                         imagem disponível, mostra um ícone neutro no lugar. -->
                    <Grid Grid.Column="0" Margin="0,25,10,25">
                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="8" ClipToBounds="True">
                            <Image Source="{Binding ProductImage}" Stretch="Uniform" Visibility="{Binding HasProductImageVisibility}" />
                        </Border>
                        <iconPacks:PackIconMaterial Kind="ImageOutline" Width="24" Height="24"
                                                     Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding NoProductImageVisibility}" />
                    </Grid>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Id do pedido menor (64->44->30, pedido explícito
                                 2026-08-06, reforçado no mesmo dia: "mesmo
                                 ajuste, só que ainda mais") — nome do cliente e
                                 produto abaixo são o que realmente importa pra
                                 não errar na separação/embalagem, o número em
                                 si é só referência. Data/hora real da venda no
                                 canal (pedido explícito 2026-08-13) ao lado. -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrderNumberText}" Style="{StaticResource MetricValueTextStyle}" FontSize="30" />
                                <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource SecondaryTextStyle}"
                                           VerticalAlignment="Bottom" Margin="10,0,0,4" />
                            </StackPanel>

                            <!-- QTD do mesmo tamanho do #id (pedido explícito
                                 2026-08-07: "diminuir o QTD, deixar do mesmo
                                 tamanho do id"). -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="QTD " Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" FontSize="30" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding UnitsCount}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" FontSize="30"
                                           Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Produto(s) + nome do cliente juntos, fonte FIXA
                             (nunca encolhe até ilegível) — pedido explícito
                             2026-08-15: até ~3 linhas cabe normal; passando
                             disso, rola dentro do ScrollViewer em vez de
                             espremer a fonte. -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ProductLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" FontSize="20" TextWrapping="Wrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding CustomerName}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" FontSize="24" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Grid, não StackPanel: precisa empurrar o botão pro
                             canto inferior DIREITO do card (pedido explícito
                             2026-08-13) enquanto o badge de canal/pedido
                             continua à esquerda — StackPanel só empilha, não
                             separa os dois lados. -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{Binding ChannelAccentBrush}" Opacity="0.85" CornerRadius="6" Padding="8,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding ChannelDisplayName}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                                <TextBlock Text="Pedido " Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ExternalOrderId, TargetNullValue='—'}" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- "Em preparação" -> clique marca embalado no
                                 servidor (OrderQueueCardViewModel.PackCommand) e
                                 o próprio botão fica VERDE + texto "Embalado"
                                 (IsPacked) — pedido explícito 2026-08-13: o
                                 pedido NÃO sai do card/da fila, o botão é só um
                                 indicador de status pra conferência visual.
                                 ToolTip mostra o erro se a chamada falhar. -->
                            <Button Grid.Column="1" Command="{Binding PackCommand}" Content="{Binding PackButtonText}"
                                    ToolTip="{Binding PackErrorMessage}"
                                    Foreground="White" FontSize="12" FontWeight="Bold" Padding="12,6" VerticalAlignment="Bottom">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource PackPreparingBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPacked}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PackPackedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Versão compacta do mesmo card, pra lista com scroll da direita
             (3º pedido do dia em diante) — mesmos dados, sem Viewbox (fonte
             fixa pequena, é só uma lista de checagem, não precisa crescer).
             Ajustes 2026-08-06: badge verde de QTD removido (virou texto
             puro do mesmo tamanho da fonte do produto, na linha do "Pedido
             #"), nome do cliente maior (13->18) e Padding/Margin reduzidos
             pra caber mais uma linha na lista sem precisar rolar. Reforçado
             ainda 2026-08-06: monitor fica na parede durante a embalagem, a
             etiqueta já saiu impressa nesse ponto — nome (18->22) e produto
             (11->14) maiores de novo, pra dar pra ler de longe sem errar na
             separação. Reforçado 2026-08-07: o nome do canal ao lado do id
             virou badge colorida (mesmo estilo do card em destaque) jogada
             pro fim da linha em vez de texto solto com " • " — ver dentro
             do template. -->
        <DataTemplate x:Key="OrderQueueRestItemTemplate" DataType="{x:Type vm:OrderQueueCardViewModel}">
            <Border Style="{StaticResource CardStyle}" Padding="8" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding ChannelAccentBrush}" CornerRadius="2" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="1">
                        <!-- Marketplace virou badge (mesma cor/estilo já
                             usado no card em destaque) jogado pro fim da
                             linha (pedido explícito 2026-08-07: "justify
                             content end"), centralizado verticalmente com o
                             id — Grid em vez de StackPanel porque
                             StackPanel não empurra nada pro fim, só
                             empilha. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding OrderNumberText}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                <!-- Data/hora real da venda no canal, pedido explícito 2026-08-13. -->
                                <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{Binding ChannelAccentBrush}" Opacity="0.85" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ChannelDisplayName}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource BodyTextStyle}" FontSize="22" FontWeight="Bold" Margin="0,1,0,0" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ProductLines}" Margin="0,1,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" FontSize="14" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Última linha do card: "Pedido X • QTD Y" à
                             esquerda + botão "Em preparação" no canto
                             inferior DIREITO (pedido explícito 2026-08-13) —
                             Grid em vez de StackPanel pelo mesmo motivo do
                             cabeçalho acima (empurrar pro fim de verdade). -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource SecondaryTextStyle}" FontSize="11" VerticalAlignment="Center">
                                <Run Text="Pedido " /><Run Text="{Binding ExternalOrderId, Mode=OneWay, TargetNullValue='—'}" FontWeight="Bold" />
                                <Run Text="  •  QTD " /><Run Text="{Binding UnitsCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" />
                            </TextBlock>

                            <Button Grid.Column="1" Command="{Binding PackCommand}" Content="{Binding PackButtonText}"
                                    ToolTip="{Binding PackErrorMessage}"
                                    Foreground="White" FontSize="10" FontWeight="Bold" Padding="8,4">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Background" Value="{DynamicResource PackPreparingBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPacked}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PackPackedBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho: logo à esquerda, texto diário centralizado (fonte
             pequena) e "ADM KazaKora" + relógio em tempo real à direita —
             layout pedido explícito 2026-08-04, substitui o antigo título
             "PAINEL DE IMPRESSÃO" + subtítulo. -->
        <!-- Cabeçalho encolhido por pedido explícito 2026-08-06 ("está muito
             alta, diminuir a altura") — mesmo conteúdo, só ocupando menos
             espaço vertical: Margin/Padding externos cortados por mais da
             metade, logo ~35% menor (LogoHeight em Dark/LightTheme.xaml,
             recurso exclusivo desse cabeçalho), fonte do título/relógio
             reduzida (FontSize inline em vez de mexer no TitleTextStyle/
             ClockTextStyle compartilhados — TitleTextStyle também é usado
             no About/Configurações, não podia encolher pra todo mundo) e
             botão de tema um pouco menor. -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="{DynamicResource LogoImageSource}" Height="{DynamicResource LogoHeight}" VerticalAlignment="Center" />

            <!-- Texto diário — só aparece quando o servidor já tem algum
                 (HasDailyTextVisibility, ver MainViewModel), itálico pra
                 marcar visualmente que é uma citação, mesma cor verde da
                 marca/logo (BrandPrimaryBrush, também usada no relógio) e
                 a referência bíblica sempre na linha de baixo — pedido
                 explícito 2026-08-04. -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Margin="16,0"
                        Visibility="{Binding HasDailyTextVisibility}">
                <TextBlock Text="{Binding DailyTextQuote}" Style="{StaticResource SecondaryTextStyle}"
                           Foreground="{DynamicResource BrandPrimaryBrush}"
                           FontSize="16" FontStyle="Italic" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DailyTextReference}" Style="{StaticResource SecondaryTextStyle}"
                           Foreground="{DynamicResource BrandPrimaryBrush}"
                           FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="0,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Right">
                <TextBlock Text="ADM KazaKora" Style="{StaticResource TitleTextStyle}" FontSize="14" HorizontalAlignment="Right" />
                <!-- CurrentDateTimeText atualizado a cada 1s por um
                     DispatcherTimer dedicado (MainWindow.xaml.cs), local,
                     sem chamada de rede. -->
                <TextBlock Text="{Binding CurrentDateTimeText}" Style="{StaticResource ClockTextStyle}" FontSize="16" HorizontalAlignment="Right" Margin="0,1,0,0" />
            </StackPanel>

            <!-- Minimizar/Maximizar: pedido explícito 2026-08-06 era usar os
                 controles NATIVOS da barra de título do Windows, não botões
                 dentro do app — versão anterior desta tela tinha botões
                 próprios aqui, removidos a pedido. O que faz os nativos
                 funcionarem é o Window.ResizeMode lá em cima (CanResize
                 agora, era NoResize — esse modo escondia os dois botões da
                 barra de título por padrão do WPF). -->
            <Button Grid.Column="3" Click="ThemeToggleButton_Click" Padding="6"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    Width="30" Height="30" ToolTip="Alternar tema">
                <Grid Width="18" Height="18">
                    <!-- Sol — visível no tema escuro (clicar troca pra claro) -->
                    <Grid x:Name="SunIcon">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Line X1="9" Y1="0" X2="9" Y2="2.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="9" Y1="15.5" X2="9" Y2="18" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="0" Y1="9" X2="2.5" Y2="9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="15.5" Y1="9" X2="18" Y2="9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="2.64" Y1="2.64" X2="4.4" Y2="4.4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="13.6" Y1="13.6" X2="15.36" Y2="15.36" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="15.36" Y1="2.64" X2="13.6" Y2="4.4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="4.4" Y1="13.6" X2="2.64" Y2="15.36" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <!-- Lua (círculo com uma mordida do fundo por cima) — visível no tema claro (clicar troca pra escuro) -->
                    <Grid x:Name="MoonIcon" Visibility="Collapsed">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Ellipse Width="13" Height="13" Fill="{DynamicResource WindowBackgroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" />
                    </Grid>
                </Grid>
            </Button>
        </Grid>
        </Border>

        <!-- Conteúdo principal -->
        <!-- HorizontalScrollBarVisibility="Disabled" explícito é a correção
             de verdade — o default do ScrollViewer é "Hidden", que (mesmo
             sem barra visível) mede o conteúdo com LARGURA INFINITA no eixo
             horizontal, porque ele "pode" rolar nesse eixo. Isso se
             propagava por toda a árvore abaixo (UniformGrid dos cards do
             topo incluso — ela divide a própria largura recebida pelas 5
             colunas, e se recebe infinito, cada card também mede como se
             tivesse espaço infinito) — por isso o Grid com coluna "*" dentro
             do card sozinho não resolvia: nunca havia uma largura real pra
             constranger nada, em lugar nenhum da árvore. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Métricas do topo (visão geral) — UniformGrid garante que
                     os 5 cards tenham exatamente o mesmo tamanho e dividam
                     igualmente a largura disponível, se adaptando sozinha a
                     qualquer largura de janela/monitor (sem WrapPanel, sem
                     largura fixa por card). ItemTemplate não é setado de
                     propósito — TopCards mistura MetricCardViewModel e
                     ChannelOrdersCardViewModel, resolvidos cada um pelo seu
                     DataTemplate implícito (ver Window.Resources). -->
                <ItemsControl ItemsSource="{Binding TopCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{Binding LastDashboardError, StringFormat='Falha ao atualizar o painel: {0}'}"
                           Foreground="{DynamicResource StatusErrorBrush}" FontWeight="Bold" Margin="0,10,0,0"
                           Visibility="{Binding HasDashboardErrorVisibility}" TextWrapping="Wrap" />

                <!-- Banner "Envios agendados" (pedido explícito 2026-08-14,
                     achado no pedido #278: venda de Coleta/Places do
                     Mercado Livre com etiqueta liberada só perto de uma
                     data futura que o PRÓPRIO canal escolheu — parecia
                     pedido travado, não era). Só aparece quando tem pelo
                     menos 1 (ScheduledShipmentsVisibility) — fica num tom
                     neutro/informativo normalmente, e muda pra vermelho só
                     quando algum item já passou da data prometida sem
                     liberar (HasOverdueScheduledShipments), pra não parecer
                     alarme falso todo santo dia. -->
                <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10" BorderThickness="1.5"
                        Visibility="{Binding ScheduledShipmentsVisibility}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource StatusProcessingSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource StatusProcessingSoftBorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasOverdueScheduledShipments}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatusErrorSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorSoftBorderBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CalendarClock" Width="20" Height="20"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Vendas agendadas pelo canal" Style="{StaticResource BodyTextStyle}"
                                       FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="28,2,0,6" TextWrapping="Wrap">
                            O próprio canal decidiu liberar a etiqueta só perto da data — não é pedido travado, é assim mesmo (Coleta/Places).
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding ScheduledShipments}" Margin="28,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{Binding ChannelAccentBrush}" Opacity="0.85" CornerRadius="6"
                                                Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChannelDisplayName}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Style="{StaticResource BodyTextStyle}" FontSize="13"
                                                    VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding OrderNumberText}" FontWeight="Bold" /><Run Text=" — " /><Run Text="{Binding CustomerName}" />
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                    Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Cards de canal (removidos da tela por pedido explícito
                     2026-08-04: "remove os cards dos canais e coloca essa
                     lista de impressão") e overlays de detalhe clicáveis
                     (removidos por outro pedido explícito, mesmo dia:
                     "remove a função de clicar nos cards e abrir outra
                     janela") — nenhum card do dashboard abre janela/overlay
                     mais, todos só exibem. Mesmo padrão repetido em
                     2026-08-06: a antiga seção "FILA DE IMPRESSÃO"
                     (contadores por status) e a lista "ETIQUETAS" (checagem
                     de empacotamento) saíram completamente do layout —
                     substituídas pela fila de expedição do dia abaixo. -->

                <!-- Fila de expedição de HOJE (pedido explícito 2026-08-06,
                     estilo "chamada de senha"): 2 cards em destaque (mais
                     recente + segundo mais recente) à esquerda + lista com
                     scroll do resto à direita, tudo em ordem decrescente —
                     ver MainViewModel.UpdateOrderQueue, alimentado por
                     DashboardPoller a cada 2s. Height fixo (420) porque os
                     dois cards usam RowDefinition="*" internamente (Viewbox
                     precisa de uma altura real pra encolher/crescer contra
                     — ver os templates em Window.Resources); esse valor foi
                     calculado pelo espaço restante da janela (820px), não
                     verificado visualmente numa tela Windows real nesta
                     sessão — pode precisar de ajuste fino ao abrir de
                     verdade. -->
                <!-- Divisão 50/50 entre os cards em destaque e a lista do
                     resto do dia (pedido explícito 2026-08-06, "col-6 pra
                     cada lado") — era largura fixa de 420px pro lado
                     direito, agora as duas colunas usam Width="*" (mesmo
                     peso, dividem igual qualquer que seja a largura da
                     janela). -->
                <Grid Margin="0,20,0,0" Height="420">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Padding 24->16 (2026-08-07, mesma rodada do
                             Row0 90->52): sobrava espaço demais nas bordas
                             enquanto nome/produto ficavam espremidos por
                             dentro — ver comentário completo dentro do
                             OrderQueueBigCardTemplate. -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,8">
                            <ContentControl Content="{Binding QueueCard1}" ContentTemplate="{StaticResource OrderQueueBigCardTemplate}" />
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,8,0,0">
                            <ContentControl Content="{Binding QueueCard2}" ContentTemplate="{StaticResource OrderQueueBigCardTemplate}" />
                        </Border>
                    </Grid>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,10">
                                <Border Style="{StaticResource SectionAccentBarStyle}" />
                                <TextBlock Text="RESTANTE DO DIA" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" Margin="16,0,16,16" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding QueueRest}" ItemTemplate="{StaticResource OrderQueueRestItemTemplate}" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Desenvolvido com " Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="❤" Style="{StaticResource FooterLinkStyle}" MouseLeftButtonUp="DevLiraLink_Click" Margin="2,0" />
                <TextBlock Text=" por " Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="Lira" Style="{StaticResource FooterLinkStyle}" MouseLeftButtonUp="DevLiraLink_Click" />
                <TextBlock Text="    |    © 2026 Kazakora. Todos os direitos reservados.    |    v1.0.0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
