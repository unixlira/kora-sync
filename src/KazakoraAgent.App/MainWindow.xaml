<Window x:Class="KazakoraAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KazakoraAgent.App.ViewModels"
        Title="KoraSync" Height="820" Width="1360"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Card de métrica (topo): ícone numa bolha colorida + rótulo + número. -->
        <DataTemplate x:Key="MetricCardTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,16,16" MinWidth="220">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="44" Height="44" Margin="0,0,12,0">
                        <Ellipse Fill="{Binding AccentBrush}" Opacity="0.16" />
                        <Viewbox Width="22" Height="22">
                            <Path Data="{Binding Icon}" Fill="{Binding AccentBrush}" Stroke="{Binding AccentBrush}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Viewbox>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding Value}" Style="{StaticResource MetricValueTextStyle}"
                                   Foreground="{Binding NumberBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Card de canal — faixa de cor da marca à esquerda, bolinha de status, clicável. -->
        <DataTemplate DataType="{x:Type vm:ChannelCardViewModel}">
            <Border Style="{StaticResource InteractiveCardStyle}" Width="300" Margin="0,0,16,16" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenDetailCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="3" Margin="0,0,14,0" />

                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" />
                            <Ellipse Grid.Column="1" Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Último pedido" Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding LastOrderLabel}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />

                        <TextBlock Text="Última etiqueta impressa" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LastLabelPrintedLabel}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0">
                            <Run Text="Etiquetas hoje: " /><Run Text="{Binding LabelsPrintedToday, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Item da fila de impressão — usado nas 4 colunas (Aguardando/Processando/Concluídos/Falhados). -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type vm:QueueItemViewModel}">
            <Border Style="{StaticResource CardStyle}" Padding="10" Margin="0,0,0,8" CornerRadius="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}" FontWeight="Bold">
                            <Run Text="Pedido #" /><Run Text="{Binding OrderId, Mode=OneWay}" />
                        </TextBlock>
                        <Ellipse Grid.Column="1" Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding ChannelDisplayName}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Text="{Binding ShippingType}" Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}">
                        <Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text=" — tentativa " /><Run Text="{Binding AttemptCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastError}" Style="{StaticResource SecondaryTextStyle}"
                                Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" />
                    <!-- .LocalDateTime — Timestamp vem em UTC (servidor/SQLite local
                         gravam tudo em UTC), sem isso mostrava hora errada. -->
                    <TextBlock Text="{Binding Timestamp.LocalDateTime, StringFormat='dd/MM HH:mm:ss'}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Linha de pedido na visão detalhada do canal. -->
        <DataTemplate x:Key="OrderRowTemplate" DataType="{x:Type vm:ChannelOrderRowViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="Bold">
                            <Run Text="#" /><Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding ExternalOrderId, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding ProductsSummary}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ShippingMethod}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bruto" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding GrossAmount, StringFormat='R$ {0:N2}'}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Taxa" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding FeeAmount, StringFormat='R$ {0:N2}', TargetNullValue=--}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="Líquido" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding NetAmount, StringFormat='R$ {0:N2}', TargetNullValue=--}"
                                    Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Status" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Margin="0,0,0,24" Padding="0,0,0,20" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{DynamicResource LogoImageSource}" Height="94" />
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="PAINEL DE IMPRESSÃO" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Acompanhe pedidos e etiquetas em tempo real" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Click="ThemeToggleButton_Click" Padding="8"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    Width="36" Height="36" ToolTip="Alternar tema">
                <Grid Width="18" Height="18">
                    <!-- Sol — visível no tema escuro (clicar troca pra claro) -->
                    <Grid x:Name="SunIcon">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Line X1="9" Y1="0" X2="9" Y2="2.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="9" Y1="15.5" X2="9" Y2="18" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="0" Y1="9" X2="2.5" Y2="9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="15.5" Y1="9" X2="18" Y2="9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="2.64" Y1="2.64" X2="4.4" Y2="4.4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="13.6" Y1="13.6" X2="15.36" Y2="15.36" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="15.36" Y1="2.64" X2="13.6" Y2="4.4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="4.4" Y1="13.6" X2="2.64" Y2="15.36" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <!-- Lua (círculo com uma mordida do fundo por cima) — visível no tema claro (clicar troca pra escuro) -->
                    <Grid x:Name="MoonIcon" Visibility="Collapsed">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Ellipse Width="13" Height="13" Fill="{DynamicResource WindowBackgroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" />
                    </Grid>
                </Grid>
            </Button>
        </Grid>
        </Border>

        <!-- Conteúdo principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Métricas do dia -->
                <ItemsControl ItemsSource="{Binding MetricCards}" ItemTemplate="{StaticResource MetricCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Cards de integração por canal -->
                <StackPanel Orientation="Horizontal" Margin="0,32,0,14">
                    <Border Style="{StaticResource SectionAccentBarStyle}" />
                    <TextBlock Text="CANAIS DE VENDA" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Fila de impressão ao vivo -->
                <StackPanel Orientation="Horizontal" Margin="0,32,0,14">
                    <Border Style="{StaticResource SectionAccentBarStyle}" />
                    <TextBlock Text="FILA DE IMPRESSÃO" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Aguardando" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource CountBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueueWaiting.Count}" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding QueueWaiting}" ItemTemplate="{StaticResource QueueItemTemplate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusProcessingBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Processando agora" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource CountBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueueProcessing.Count}" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding QueueProcessing}" ItemTemplate="{StaticResource QueueItemTemplate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusSuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Concluídos hoje" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource CountBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueueCompletedToday.Count}" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding QueueCompletedToday}" ItemTemplate="{StaticResource QueueItemTemplate}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusErrorBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Falhados / Retentativa" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource CountBadgeStyle}" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueueFailedOrRetrying.Count}" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding QueueFailedOrRetrying}" ItemTemplate="{StaticResource QueueItemTemplate}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Desenvolvido com " Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="❤" Style="{StaticResource FooterLinkStyle}" MouseLeftButtonUp="DevLiraLink_Click" Margin="2,0" />
                <TextBlock Text=" por " Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="Lira" Style="{StaticResource FooterLinkStyle}" MouseLeftButtonUp="DevLiraLink_Click" />
                <TextBlock Text="    |    © 2026 Kazakora. Todos os direitos reservados.    |    v1.0.0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Overlay da visão detalhada do canal -->
        <Grid Grid.RowSpan="3" Background="#CC000000" Visibility="{Binding IsShowingDetail, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" Margin="60" DataContext="{Binding SelectedDetail}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TitleTextStyle}" />
                        <Button Grid.Column="1" Content="Voltar" Padding="12,6"
                                Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Orders}" ItemTemplate="{StaticResource OrderRowTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
