<Window x:Class="KazakoraAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KazakoraAgent.App.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="KoraSync" Height="820" Width="1360"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Card de métrica (topo): ícone numa bolha colorida + rótulo (com
             período real vindo do servidor) + número grande + variação
             percentual colorida (verde alta, vermelha queda), quando houver
             base de comparação. Sem x:Key de propósito — é resolvido
             implicitamente pelo DataType (mesmo padrão já usado pros cards
             de canal/fila), pra poder conviver com ChannelOrdersCardTemplate
             na mesma UniformGrid (ver TopCards no MainViewModel). Sem
             largura/margem fixa: a UniformGrid do container é quem garante
             que todo card do topo tenha exatamente o mesmo tamanho,
             adaptável a qualquer largura de janela/monitor. -->
        <DataTemplate DataType="{x:Type vm:MetricCardViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="8" Padding="22">
                <!-- Grid, não StackPanel horizontal — mesma correção do
                     ChannelOrdersCardTemplate (ver comentário lá): StackPanel
                     horizontal dá largura infinita pro filho, o que quebra
                     TextWrapping/TextTrimming (o texto nunca sabe onde
                     cortar/quebrar de verdade). Coluna "*" constrange o
                     espaço disponível de verdade. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse Fill="{Binding AccentBrush}" Opacity="0.16" />
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Width="28" Height="28"
                                                     Foreground="{Binding AccentBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
                            <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding PeriodLabel, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Value}" Style="{StaticResource MetricValueTextStyle}"
                                   FontSize="30" Foreground="{Binding NumberBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding VariationText}" Foreground="{Binding VariationBrush}"
                                   Visibility="{Binding VariationVisibility}" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 5º card do topo — "Pedidos por canal, hoje". Mesmo visual dos
             outros 4 (ícone em bolha + rótulo), mas o "valor" é uma lista
             de chips "Nome: total", um por canal com pedido > 0 hoje —
             canal zerado/sem pedido simplesmente não aparece na lista. -->
        <DataTemplate DataType="{x:Type vm:ChannelOrdersCardViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="8" Padding="22">
                <!-- Grid, não StackPanel horizontal: um StackPanel horizontal
                     dá largura INFINITA pro filho, então o WrapPanel das
                     badges nunca detectava que precisava quebrar (só
                     descobria o limite real, tarde demais, na hora de
                     desenhar — daí o corte). A coluna "*" aqui constrange de
                     verdade o espaço disponível, então o WrapPanel quebra
                     pra segunda linha de verdade quando não couber mais. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Top">
                        <Ellipse Fill="{DynamicResource BrandPrimaryBrush}" Opacity="0.16" />
                        <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Width="28" Height="28"
                                                     Foreground="{DynamicResource BrandPrimaryBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <!-- Badges pequenas de propósito (pedido explícito
                             2026-08-04) — as 5 integrações precisam caber
                             sem fazer esse card (e por tabela os outros 4 da
                             mesma UniformGrid, que têm altura sincronizada)
                             crescerem de tamanho. -->
                        <ItemsControl ItemsSource="{Binding Entries}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding AccentBrush}" Opacity="0.85" CornerRadius="7" Padding="6,2" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="Bold" Foreground="{Binding TextBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Card de canal — faixa de cor da marca à esquerda, bolinha de
             status, as mesmas 4 métricas do topo (individuais do canal) +
             total de vendas do mês. Clicável (abre a listagem de pedidos
             do canal). -->
        <DataTemplate DataType="{x:Type vm:ChannelCardViewModel}">
            <Border Style="{StaticResource InteractiveCardStyle}" Width="230" Padding="14" Margin="0,0,12,16" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenDetailCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="3" Margin="0,0,14,0" />

                    <StackPanel Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <Ellipse Grid.Column="1" Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding SalesMonthText}" Style="{StaticResource SecondaryTextStyle}" FontSize="10" Margin="0,2,0,0" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mês" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
                                <TextBlock Text="{Binding RevenueMonthText}" Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Hoje" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
                                <TextBlock Text="{Binding RevenueTodayText}" Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pedidos hoje" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
                                <TextBlock Text="{Binding OrdersTodayText}" Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Devoluções" Style="{StaticResource SecondaryTextStyle}" FontSize="10" />
                                <TextBlock Text="{Binding ReturnsMonthText}" Style="{StaticResource BodyTextStyle}" FontSize="12" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="10" Margin="0,10,0,0">
                            <Run Text="Etiquetas hoje: " /><Run Text="{Binding LabelsPrintedToday, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Card de status da fila (Na fila/Imprimindo/Concluídas/Falharam) — mesmo
             padrão visual dos cards de "Impressões" do painel Casa Cora: fundo e
             borda tingidos na cor do status, ícone em bolha, contagem em destaque.
             Clicável — abre a listagem completa daquele status. -->
        <DataTemplate DataType="{x:Type vm:QueueStatusCardViewModel}">
            <Border Style="{StaticResource StatusCardStyle}" Background="{Binding CardBackgroundBrush}"
                    BorderBrush="{Binding CardBorderBrush}" Width="270" Margin="0,0,16,16">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                </Border.InputBindings>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="44" Height="44" HorizontalAlignment="Left">
                            <Ellipse Fill="{Binding AccentBrush}" Opacity="0.18" />
                            <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Width="22" Height="22"
                                                         Foreground="{Binding AccentBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource MetricValueTextStyle}"
                                    Foreground="{Binding AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Linha da listagem de detalhe de um status da fila — faixa na cor do
             canal (mesma linguagem do card de canal), pedido, ID da impressão
             (ServerJobId, chave real do PrintJob no servidor) e status. -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type vm:QueueItemViewModel}">
            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding ChannelAccentBrush}" CornerRadius="3" Margin="0,0,14,0" />

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="Bold">
                                <Run Text="{Binding ChannelDisplayName}" /><Run Text=" — Pedido #" /><Run Text="{Binding OrderId, Mode=OneWay, TargetNullValue=—}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0">
                                <Run Text="ID da impressão: #" /><Run Text="{Binding ServerJobId, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ShippingType}" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{Binding LastError}" Style="{StaticResource SecondaryTextStyle}"
                                        Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                    <Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text=" (tentativa " /><Run Text="{Binding AttemptCount, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                            <!-- .LocalDateTime — Timestamp vem em UTC (servidor/SQLite local
                                 gravam tudo em UTC), sem isso mostrava hora errada. -->
                            <TextBlock Text="{Binding Timestamp.LocalDateTime, StringFormat='dd/MM HH:mm:ss'}"
                                        Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Card da lista de etiquetas (produto/SKU/pedido) — lista de
             checagem pra empacotamento, não dispara nada (a impressão em si
             já é automática): um funcionário olha canal+produto+quantidade+
             SKU, empacota, e fecha no X (some da tela, o PrintJob continua
             no banco — ver MainViewModel.DismissLabel). Se tiver dúvida, o
             pedido no canal (ExternalOrderId) está ali pra conferir na
             própria plataforma do marketplace. -->
        <DataTemplate x:Key="LabelItemTemplate" DataType="{x:Type vm:LabelItemViewModel}">
            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding ChannelAccentBrush}" CornerRadius="3" Margin="0,0,14,0" />

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ChannelDisplayName}" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                                <TextBlock Text=" • Pedido " Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{Binding ExternalOrderId, TargetNullValue='—'}" Style="{StaticResource SecondaryTextStyle}" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding QuantityLabel, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ProductName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0">
                                <Run Text="SKU: " /><Run Text="{Binding Sku, Mode=OneWay, TargetNullValue='—'}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource SecondaryTextStyle}"
                                        Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding StatusLabel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Timestamp.LocalDateTime, StringFormat='dd/MM HH:mm'}"
                                        Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- X — conferido/empacotado, some da tela (não apaga o
                         registro). Fica no canto superior direito do card,
                         separado do resto pra não ser confundido com uma
                         ação sobre a etiqueta em si. -->
                    <Button Grid.Column="2" Content="✕" Command="{Binding DismissCommand}"
                            ToolTip="Já empacotado — remover da lista"
                            Width="26" Height="26" Padding="0" VerticalAlignment="Top" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                            FontSize="14" Cursor="Hand" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Linha de pedido na visão detalhada do canal. -->
        <DataTemplate x:Key="OrderRowTemplate" DataType="{x:Type vm:ChannelOrderRowViewModel}">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="Bold">
                            <Run Text="#" /><Run Text="{Binding Id, Mode=OneWay}" /><Run Text=" — " /><Run Text="{Binding ExternalOrderId, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CustomerName}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding ProductsSummary}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ShippingMethod}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Bruto" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding GrossAmount, StringFormat='R$ {0:N2}'}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Taxa" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding FeeAmount, StringFormat='R$ {0:N2}', TargetNullValue=--}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="Líquido" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding NetAmount, StringFormat='R$ {0:N2}', TargetNullValue=--}"
                                    Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource BrandPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <TextBlock Text="Status" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource BodyTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Margin="0,0,0,24" Padding="0,0,0,20" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{DynamicResource LogoImageSource}" Height="{DynamicResource LogoHeight}" />
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="PAINEL DE IMPRESSÃO" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Acompanhe pedidos e etiquetas em tempo real" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" Click="ThemeToggleButton_Click" Padding="8"
                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    Width="36" Height="36" ToolTip="Alternar tema">
                <Grid Width="18" Height="18">
                    <!-- Sol — visível no tema escuro (clicar troca pra claro) -->
                    <Grid x:Name="SunIcon">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Line X1="9" Y1="0" X2="9" Y2="2.5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="9" Y1="15.5" X2="9" Y2="18" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="0" Y1="9" X2="2.5" Y2="9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="15.5" Y1="9" X2="18" Y2="9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="2.64" Y1="2.64" X2="4.4" Y2="4.4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="13.6" Y1="13.6" X2="15.36" Y2="15.36" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="15.36" Y1="2.64" X2="13.6" Y2="4.4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Line X1="4.4" Y1="13.6" X2="2.64" Y2="15.36" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Grid>
                    <!-- Lua (círculo com uma mordida do fundo por cima) — visível no tema claro (clicar troca pra escuro) -->
                    <Grid x:Name="MoonIcon" Visibility="Collapsed">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource TextPrimaryBrush}" />
                        <Ellipse Width="13" Height="13" Fill="{DynamicResource WindowBackgroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" />
                    </Grid>
                </Grid>
            </Button>
        </Grid>
        </Border>

        <!-- Conteúdo principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Métricas do topo (visão geral) — UniformGrid garante que
                     os 5 cards tenham exatamente o mesmo tamanho e dividam
                     igualmente a largura disponível, se adaptando sozinha a
                     qualquer largura de janela/monitor (sem WrapPanel, sem
                     largura fixa por card). ItemTemplate não é setado de
                     propósito — TopCards mistura MetricCardViewModel e
                     ChannelOrdersCardViewModel, resolvidos cada um pelo seu
                     DataTemplate implícito (ver Window.Resources). -->
                <ItemsControl ItemsSource="{Binding TopCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock Text="{Binding LastDashboardError, StringFormat='Falha ao atualizar o painel: {0}'}"
                           Foreground="{DynamicResource StatusErrorBrush}" FontWeight="Bold" Margin="0,10,0,0"
                           Visibility="{Binding HasDashboardErrorVisibility}" TextWrapping="Wrap" />

                <!-- Cards de canal (removidos da tela por pedido explícito
                     — 2026-08-04: "remove os cards dos canais e coloca essa
                     lista de impressão"). MainViewModel.Channels continua
                     existindo e sendo atualizado (OpenChannelDetail ainda é
                     usado pelo botão "Ver detalhes" de cada etiqueta), só
                     não tem mais uma seção própria na tela. -->

                <!-- Fila de impressão (contadores por status) — centralizada
                     na página, não colada na borda esquerda. -->
                <StackPanel Orientation="Horizontal" Margin="0,32,0,14" HorizontalAlignment="Center">
                    <Border Style="{StaticResource SectionAccentBarStyle}" />
                    <TextBlock Text="FILA DE IMPRESSÃO" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding QueueStatusCards}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Lista de etiquetas (canal, produto, quantidade, SKU,
                     pedido no canal, status) — centralizada num container de
                     largura máxima 1100, uma etiqueta por linha ocupando a
                     largura inteira desse container
                     (HorizontalContentAlignment=Stretch + Border com
                     HorizontalAlignment=Stretch no template), mais recentes
                     no topo. Sem etiqueta de agradecimento — já filtrada no
                     servidor (is_thank_you=false). O scroll é o mesmo
                     ScrollViewer vertical da página inteira, de propósito
                     (evita scroll aninhado). -->
                <StackPanel Orientation="Horizontal" Margin="0,32,0,14" HorizontalAlignment="Center">
                    <Border Style="{StaticResource SectionAccentBarStyle}" />
                    <TextBlock Text="ETIQUETAS" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding LastLabelsError, StringFormat='Falha ao carregar a lista de etiquetas: {0}'}"
                           Foreground="{DynamicResource StatusErrorBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"
                           Visibility="{Binding HasLabelsErrorVisibility}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Labels}" ItemTemplate="{StaticResource LabelItemTemplate}"
                              HorizontalAlignment="Center" HorizontalContentAlignment="Stretch" MaxWidth="1100" />
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Desenvolvido com " Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="❤" Style="{StaticResource FooterLinkStyle}" MouseLeftButtonUp="DevLiraLink_Click" Margin="2,0" />
                <TextBlock Text=" por " Style="{StaticResource SecondaryTextStyle}" />
                <TextBlock Text="Lira" Style="{StaticResource FooterLinkStyle}" MouseLeftButtonUp="DevLiraLink_Click" />
                <TextBlock Text="    |    © 2026 Kazakora. Todos os direitos reservados.    |    v1.0.0"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </Grid>

        <!-- Overlay da visão detalhada do canal -->
        <Grid Grid.RowSpan="3" Background="#CC000000" Visibility="{Binding IsShowingDetail, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" Margin="60" DataContext="{Binding SelectedDetail}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Style="{StaticResource TitleTextStyle}" />
                        <Button Grid.Column="1" Content="Voltar" Padding="12,6"
                                Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Orders}" ItemTemplate="{StaticResource OrderRowTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay da listagem de detalhe de um status da fila (aberto ao
             clicar num dos cards "Na fila/Imprimindo/Concluídas/Falharam"). -->
        <Grid Grid.RowSpan="3" Background="#CC000000" Visibility="{Binding IsShowingQueueDetail, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource CardStyle}" Margin="60">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding QueueDetailTitle}" Style="{StaticResource TitleTextStyle}" />
                        <Button Grid.Column="1" Content="Voltar" Padding="12,6"
                                Command="{Binding CloseQueueDetailCommand}"
                                Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedQueueItems}" ItemTemplate="{StaticResource QueueItemTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
